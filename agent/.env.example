LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Comma-separated domains Nova's browser tools may open. Subdomains are included.
# Leave unset for local development to allow the whole public web. Set it when you
# deploy: leaving it unset lets the agent reach any site on the internet.
# NOVA_BROWSER_ALLOWED_DOMAINS=bbc.co.uk,example.org

# Optional overrides for the small helper models the browser tools use. Both are
# reached through LiveKit Inference, so LIVEKIT_API_KEY covers them.
# NOVA_BROWSER_SUMMARIZER_MODEL=google/gemini-2.5-flash
# NOVA_BROWSER_PLANNER_MODEL=google/gemini-2.5-flash-lite
